    "@types/react-dom": "^18.3.3",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "latest",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
